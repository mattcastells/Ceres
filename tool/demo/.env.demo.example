# Configuración de la demo local. Copialo a `tool/demo/.env.demo` (ignorado
# por git) y completalo. `levantar.ps1` lo crea solo la primera vez.

# Para que la IA ande en la demo (foto, texto, informes). Se saca de
# https://aistudio.google.com/apikey. Sin esto, todo lo demás funciona.
GEMINI_API_KEY=

# Opcional: el respaldo cuando Gemini no responde.
ANTHROPIC_API_KEY=

# La contraseña de todas las cuentas de la demo (y de tu cuenta copiada).
DEMO_PASSWORD=ceres-demo-2026
