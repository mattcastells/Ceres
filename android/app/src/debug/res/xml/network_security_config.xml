<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en debug: deja hablar HTTP sin cifrar con la base local de la demo
  (`tool/demo/`). El emulador ve la notebook como 10.0.2.2.

  El release no trae este archivo y sigue exigiendo HTTPS para todo, que es lo
  que tiene que pasar con datos de salud. El teléfono de la demo llega a la
  base local por un túnel HTTPS, así que tampoco lo necesita.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
